# Supabase Configuration
# Get these from your Supabase Dashboard -> Settings -> API

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (safe to expose to client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (KEEP SECRET - server-side only)
# This key bypasses Row Level Security (RLS) - never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret for Custom Authentication
# Generate a strong random secret: openssl rand -base64 32
# IMPORTANT: Change this from the default value in production!
JWT_SECRET=your-secret-key-here-change-in-production

# Database migration (see MIGRATION.md)
# DATABASE_URL = Postgres connection string (for run-migrations.js)
# OLD_DATABASE_URL / NEW_DATABASE_URL = for copy-data-to-new-db.js
